{
  "name": "@isavonxz-type/opencode-themes",
  "version": "1.0.1",
  "description": "Nine hand-tuned color themes (light and dark) for OpenCode Desktop.",
  "keywords": ["opencode", "opencode-plugin", "opencode-theme", "theme", "desktop"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/IsaVonxz-type/opencode-themes.git"
  },
  "type": "module",
  "exports": {
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "files": ["dist", "assets/theme-gallery.svg", "README.md", "CHANGELOG.md", "LICENSE"],
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "vite build",
    "generate:gallery": "node scripts/generate-gallery.mjs",
    "prepublishOnly": "npm run validate:themes && npm run generate:gallery && npm run build",
    "validate:themes": "node scripts/validate-themes.mjs"
  },
  "dependencies": {
    "@opencode/plugin": "^2.2.6"
  },
  "devDependencies": {
    "solid-js": "^1.9.0",
    "vite": "^7.0.0",
    "vite-plugin-solid": "^2.11.0"
  }
}
